server.port=8087
server.address=127.0.0.1

spring.application.name=mcp-pos-server
spring.ai.mcp.server.name=harmoni-pos-mcp
spring.ai.mcp.server.version=0.0.1
spring.ai.mcp.server.type=sync
spring.ai.mcp.server.sse-endpoint=/api/v1/mcp/sse
spring.ai.mcp.server.sse-message-endpoint=/api/v1/mcp/message
spring.ai.mcp.server.capabilities.tool=true
spring.ai.mcp.server.capabilities.resource=false
spring.ai.mcp.server.capabilities.prompt=false
spring.ai.mcp.server.capabilities.completion=false
spring.ai.mcp.server.request-timeout=30s

management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=never

harmoni.mcp.order.base-url=${ORDER_SERVICE_URL:http://localhost:8083}
harmoni.mcp.menu.base-url=${MENU_SERVICE_URL:http://localhost:8082}
harmoni.mcp.customer.base-url=${CUSTOMER_SERVICE_URL:http://localhost:8084}
harmoni.mcp.connect-timeout=5s
harmoni.mcp.read-timeout=30s
harmoni.mcp.allow-default-caller=${MCP_ALLOW_DEFAULT_CALLER:false}
harmoni.mcp.default-username=${MCP_DEFAULT_USERNAME:Kasir1}
harmoni.mcp.default-roles=${MCP_DEFAULT_ROLES:}
harmoni.mcp.default-permissions=${MCP_DEFAULT_PERMISSIONS:order:view,report:view,menu:view,customer:read}
harmoni.mcp.default-scopes=${MCP_DEFAULT_SCOPES:}

logging.level.com.harmoni.pos.mcp=INFO
